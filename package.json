{
  "name": "time-pulse",
  "version": "0.11.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "tsc -b && ANALYZE=1 vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "tauri": "tauri",
    "icon:generate": "tauri icon public/logo.png",
    "patch:android-icons": "node scripts/patch-android-icons.mjs",
    "patch:android-orientation": "node scripts/patch-android-orientation.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "capture:screenshots": "node scripts/capture-docs-screenshots.mjs",
    "sync:releases": "node scripts/sync-github-releases.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "version:sync": "node scripts/sync-tauri-version.mjs",
    "seed:quotes": "node scripts/seed-quotes.mjs",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@number-flow/react": "0.6.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tauri-apps/plugin-deep-link": "^2.6.2",
    "@tauri-apps/plugin-haptics": "^2.4.2",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "~2.7.2",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.58.0",
    "overlayscrollbars": "^2.16.0",
    "react": "19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "19.3.0",
    "react-icons": "^4.12.0",
    "solarlunar": "^2.0.7",
    "uuid": "^9.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.9.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "class-variance-authority": "^0.7.1",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "pg": "^8.23.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "prisma": "8.0.0-rc.23",
    "radix-ui": "^1.6.7",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^3.2.7"
  }
